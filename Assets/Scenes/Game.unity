  m_Name: 
  m_EditorClassIdentifier: 
  roundTooltips:
  - roundNumber: 1
    tooltip: 'The dark wizard has sent monsters to destroy your castle!


      Quick,
      place some towers to defend!'
  - roundNumber: 2
    tooltip: 'Try upgrading your towers by clicking on them.


      Towers get a
      specialisation at level 4!'
  - roundNumber: 3
    tooltip: Flying devils coming your way... beware, cannons can't hit them.
  - roundNumber: 4
    tooltip: Every round you get a skill point. Check out the skill tree by pressing
      S or the button in the top right
  - roundNumber: 5
    tooltip: Try to balance the types of towers you use, and where they are placed
      on the paths.
  - roundNumber: 6
    tooltip: A dark knight!!! You'll need all the towers you have to defeat him.
  - roundNumber: 7
    tooltip: Those specialised towers are nice, huh?
  - roundNumber: 8
    tooltip: More dark knights!!! Prepare!
  - roundNumber: 9
    tooltip: It's getting dangerous now... who knows what the dark wizard will send
      next...
  - roundNumber: 10
    tooltip: I hear the roars of a terrible beast...
  tooltipText: {fileID: 2089102932}
  popup: {fileID: 1770032511}
  popupSpeed: 0.01
